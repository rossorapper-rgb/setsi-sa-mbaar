rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function currentUser() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && currentUser().data.role == 'admin' && currentUser().data.actif == true; }
    function isResponsable() { return signedIn() && currentUser().data.role == 'responsable' && currentUser().data.actif == true; }
    function belongsToBergerie(bergerieId) { return signedIn() && currentUser().data.actif == true && currentUser().data.bergerieId == bergerieId; }
    function belongsToClient(clientId) { return signedIn() && currentUser().data.actif == true && currentUser().data.bergerieId != null && currentUser().data.bergerieId != '' && get(/databases/$(database)/documents/bergeries/$(currentUser().data.bergerieId)).data.clientId == clientId; }
    function canViewMoutons() { return isAdmin() || isResponsable() || (signedIn() && currentUser().data.actif == true && currentUser().data.permissions['moutons.view'] == true); }
    function canCreateMouton() { return isAdmin() || isResponsable() || (signedIn() && currentUser().data.actif == true && currentUser().data.permissions['moutons.edit'] == true); }
    function canUpdateMouton() { return isAdmin() || isResponsable() || (signedIn() && currentUser().data.actif == true && currentUser().data.permissions['moutons.edit'] == true); }
    function canManageReproduction() { return signedIn() && currentUser().data.actif == true && (currentUser().data.role == 'responsable' || currentUser().data.role == 'technicien'); }
    function canManageGestation() { return signedIn() && currentUser().data.actif == true && (currentUser().data.role == 'responsable' || currentUser().data.role == 'technicien'); }
    function canManageVeterinaires() { return signedIn() && currentUser().data.actif == true && (currentUser().data.role == 'responsable' || currentUser().data.role == 'technicien' || currentUser().data.role == 'client'); }
    function canManageSante() { return signedIn() && currentUser().data.actif == true && (currentUser().data.role == 'responsable' || currentUser().data.role == 'technicien' || currentUser().data.role == 'client'); }
    function canViewAlimentation() { return isAdmin() || isResponsable() || (signedIn() && currentUser().data.actif == true && currentUser().data.permissions['alimentation.view'] == true); }
    function canEditAlimentation() { return isAdmin() || isResponsable() || (signedIn() && currentUser().data.actif == true && currentUser().data.permissions['alimentation.edit'] == true); }
    function canManageInterventions() { return signedIn() && currentUser().data.actif == true && (currentUser().data.role == 'responsable' || currentUser().data.role == 'technicien' || currentUser().data.role == 'client'); }
    function canViewDepenses() { return isAdmin() || (signedIn() && currentUser().data.actif == true && (currentUser().data.role == 'responsable' || currentUser().data.permissions['depenses.view'] == true)); }
    function canEditDepenses() { return isAdmin() || (signedIn() && currentUser().data.actif == true && (currentUser().data.role == 'responsable' || currentUser().data.permissions['depenses.edit'] == true)); }
    function canViewVentes() { return isAdmin() || (signedIn() && currentUser().data.actif == true && (currentUser().data.role == 'responsable' || currentUser().data.permissions['ventes.view'] == true)); }
    function canEditVentes() { return isAdmin() || (signedIn() && currentUser().data.actif == true && (currentUser().data.role == 'responsable' || currentUser().data.permissions['ventes.edit'] == true)); }

    function canManageStock() { return signedIn() && currentUser().data.actif == true && (currentUser().data.role == 'responsable' || currentUser().data.role == 'technicien'); }
    function canManageFinance() { return signedIn() && currentUser().data.actif == true && (currentUser().data.role == 'responsable' || currentUser().data.role == 'technicien' || currentUser().data.role == 'client'); }
    function belongsToMouton(moutonId) { return signedIn() && currentUser().data.actif == true && exists(/databases/$(database)/documents/moutons/$(moutonId)) && get(/databases/$(database)/documents/moutons/$(moutonId)).data.bergerieId == currentUser().data.bergerieId; }

    match /users/{userId} {
      allow read: if isAdmin() || (
        signedIn() &&
        currentUser().data.actif == true &&
        (
          request.auth.uid == userId ||
          (resource.data.bergerieId != null &&
           resource.data.bergerieId == currentUser().data.bergerieId)
        )
      );
      allow create: if isAdmin() || (
        signedIn() &&
        currentUser().data.actif == true &&
        currentUser().data.role == 'responsable' &&
        request.resource.data.bergerieId == currentUser().data.bergerieId &&
        request.resource.data.role != 'admin'
      );
      allow update: if isAdmin() || (
        signedIn() &&
        currentUser().data.actif == true &&
        currentUser().data.role == 'responsable' &&
        resource.data.bergerieId == currentUser().data.bergerieId &&
        request.resource.data.bergerieId == resource.data.bergerieId &&
        request.resource.data.role != 'admin' &&
        (
          request.auth.uid != userId ||
          request.resource.data.permissions == resource.data.permissions
        )
      );
      allow delete: if isAdmin() || (
        signedIn() &&
        currentUser().data.actif == true &&
        currentUser().data.role == 'responsable' &&
        resource.data.bergerieId == currentUser().data.bergerieId
      );
    }
    match /bergerie_config/{bergerieId} {
      allow read: if isAdmin() || belongsToBergerie(bergerieId);
      allow create: if isAdmin() || (
        belongsToBergerie(bergerieId) &&
        currentUser().data.role == 'responsable' &&
        request.resource.data.bergerieId == bergerieId &&
        request.resource.data.active == true
      );
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        belongsToBergerie(bergerieId) &&
        currentUser().data.role == 'responsable' &&
        request.resource.data.bergerieId == resource.data.bergerieId &&
        request.resource.data.active == resource.data.active
      );
    }
    match /bergerie_public_config/{bergerieId} {
      allow read: if true;

      allow create: if isAdmin() || (
        belongsToBergerie(bergerieId) &&
        currentUser().data.role == 'responsable' &&
        request.resource.data.bergerieId == bergerieId &&
        request.resource.data.keys().hasOnly([
          'bergerieId',
          'nomBergerie',
          'nomApplication',
          'logo',
          'imageAccueil',
          'couleurPrimaire',
          'couleurSecondaire',
          'couleurFond',
          'slogan',
          'active'
        ])
      );

      allow update: if isAdmin() || (
        belongsToBergerie(bergerieId) &&
        currentUser().data.role == 'responsable' &&
        request.resource.data.bergerieId == resource.data.bergerieId &&
        request.resource.data.keys().hasOnly([
          'bergerieId',
          'nomBergerie',
          'nomApplication',
          'logo',
          'imageAccueil',
          'couleurPrimaire',
          'couleurSecondaire',
          'couleurFond',
          'slogan',
          'active'
        ])
      );

      allow delete: if isAdmin();
    }
    match /bergeries/{bergerieId} { allow read: if isAdmin() || belongsToBergerie(bergerieId); allow create, update, delete: if isAdmin(); }
    match /clients/{clientId} { allow read: if isAdmin() || belongsToClient(clientId); allow create, update, delete: if isAdmin(); }

    match /veterinaires/{veterinaireId} {
      allow read: if isAdmin() || belongsToBergerie(resource.data.bergerieId);
      allow create: if isAdmin() || (canManageVeterinaires() && belongsToBergerie(request.resource.data.bergerieId));
      allow update: if isAdmin() || (canManageVeterinaires() && belongsToBergerie(resource.data.bergerieId) && request.resource.data.bergerieId == resource.data.bergerieId);
      allow delete: if isAdmin() || (canManageVeterinaires() && belongsToBergerie(resource.data.bergerieId));
    }

    match /carnet_sante/{soinId} {
      allow read: if isAdmin() || (signedIn() && currentUser().data.actif == true && currentUser().data.bergerieId == resource.data.bergerieId);
      allow create: if isAdmin() || (canManageSante() && belongsToBergerie(request.resource.data.bergerieId) && belongsToMouton(request.resource.data.moutonId));
      allow update: if isAdmin() || (canManageSante() && belongsToBergerie(resource.data.bergerieId) && request.resource.data.bergerieId == resource.data.bergerieId && belongsToMouton(request.resource.data.moutonId));
      allow delete: if isAdmin() || (canManageSante() && belongsToBergerie(resource.data.bergerieId) && belongsToMouton(resource.data.moutonId));
    }

    match /alimentations/{alimentationId} {
      allow read: if canViewAlimentation() && belongsToBergerie(resource.data.bergerieId);
      allow create: if canEditAlimentation() && belongsToBergerie(request.resource.data.bergerieId);
      allow update: if canEditAlimentation() && belongsToBergerie(resource.data.bergerieId) && request.resource.data.bergerieId == resource.data.bergerieId;
      allow delete: if canEditAlimentation() && belongsToBergerie(resource.data.bergerieId);
    }

    match /interventions/{interventionId} {
      allow read: if isAdmin() || belongsToBergerie(resource.data.bergerieId);
      allow create: if isAdmin() || (canManageInterventions() && belongsToBergerie(request.resource.data.bergerieId));
      allow update: if isAdmin() || (canManageInterventions() && belongsToBergerie(resource.data.bergerieId) && request.resource.data.bergerieId == resource.data.bergerieId);
      allow delete: if isAdmin() || (canManageInterventions() && belongsToBergerie(resource.data.bergerieId));
    }

    match /stock_produits/{produitId} {
      allow read: if isAdmin() || belongsToBergerie(resource.data.bergerieId);
      allow create: if isAdmin() || (canManageStock() && belongsToBergerie(request.resource.data.bergerieId));
      allow update: if isAdmin() || (canManageStock() && belongsToBergerie(resource.data.bergerieId) && request.resource.data.bergerieId == resource.data.bergerieId);
      allow delete: if isAdmin() || (canManageStock() && belongsToBergerie(resource.data.bergerieId));
    }

    match /finance_entries/{entryId} {
      allow read: if isAdmin() || isResponsable() ||
        (belongsToBergerie(resource.data.bergerieId) &&
         ((resource.data.type == 'depense' && canViewDepenses()) ||
          (resource.data.type == 'vente' && canViewVentes())));
      allow create: if isAdmin() || isResponsable() ||
        (belongsToBergerie(request.resource.data.bergerieId) &&
         ((request.resource.data.type == 'depense' && canEditDepenses()) ||
          (request.resource.data.type == 'vente' && canEditVentes())));
      allow update: if isAdmin() || isResponsable() ||
        (belongsToBergerie(resource.data.bergerieId) &&
         request.resource.data.bergerieId == resource.data.bergerieId &&
         ((resource.data.type == 'depense' && request.resource.data.type == 'depense' && canEditDepenses()) ||
          (resource.data.type == 'vente' && request.resource.data.type == 'vente' && canEditVentes())));
      allow delete: if isAdmin() || isResponsable() ||
        (belongsToBergerie(resource.data.bergerieId) &&
         ((resource.data.type == 'depense' && canEditDepenses()) ||
          (resource.data.type == 'vente' && canEditVentes())));
    }

    match /moutons/{moutonId} {
      allow read: if canViewMoutons() && belongsToBergerie(resource.data.bergerieId);
      allow create: if isAdmin() || (canCreateMouton() && belongsToBergerie(request.resource.data.bergerieId));
      allow update: if isAdmin() || (canUpdateMouton() && belongsToBergerie(resource.data.bergerieId) && request.resource.data.bergerieId == resource.data.bergerieId);
      allow delete: if isAdmin() || (canUpdateMouton() && belongsToBergerie(resource.data.bergerieId));
    }

    match /gestations/{gestationId} {
      allow read: if isAdmin() || belongsToBergerie(resource.data.bergerieId);
      allow create: if isAdmin() || (canManageGestation() && belongsToBergerie(request.resource.data.bergerieId));
      allow update: if isAdmin() || (canManageGestation() && belongsToBergerie(resource.data.bergerieId) && request.resource.data.bergerieId == resource.data.bergerieId);
      allow delete: if isAdmin() || (canManageGestation() && belongsToBergerie(resource.data.bergerieId));
    }

    match /reproductions/{reproductionId} {
      allow read: if isAdmin() || belongsToMouton(resource.data.moutonId);
      allow create: if isAdmin() || (canManageReproduction() && belongsToMouton(request.resource.data.moutonId));
      allow update: if isAdmin() || (canManageReproduction() && belongsToMouton(resource.data.moutonId) && request.resource.data.moutonId == resource.data.moutonId);
      allow delete: if isAdmin() || (canManageReproduction() && belongsToMouton(resource.data.moutonId));
    }

    match /mises_bas/{miseBasId} {
      allow read: if isAdmin() || belongsToMouton(resource.data.moutonId);
      allow create: if isAdmin() || (canManageReproduction() && belongsToMouton(request.resource.data.moutonId));
      allow update: if isAdmin() || (canManageReproduction() && belongsToMouton(resource.data.moutonId) && request.resource.data.moutonId == resource.data.moutonId);
      allow delete: if isAdmin() || (canManageReproduction() && belongsToMouton(resource.data.moutonId));
    }

    match /{document=**} { allow read, write: if isAdmin(); }
  }
}
