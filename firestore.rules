rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && currentUser().data.role == 'admin'
        && currentUser().data.actif == true;
    }

    function belongsToBergerie(bergerieId) {
      return signedIn()
        && currentUser().data.actif == true
        && currentUser().data.bergerieId == bergerieId;
    }

    function belongsToClient(clientId) {
      return signedIn()
        && currentUser().data.actif == true
        && currentUser().data.bergerieId != null
        && currentUser().data.bergerieId != ''
        && get(/databases/$(database)/documents/bergeries/$(currentUser().data.bergerieId)).data.clientId == clientId;
    }

    function canCreateMouton() {
      return signedIn()
        && currentUser().data.actif == true
        && (currentUser().data.role == 'responsable'
          || currentUser().data.role == 'technicien'
          || currentUser().data.role == 'client');
    }

    function canUpdateMouton() {
      return signedIn()
        && currentUser().data.actif == true
        && (currentUser().data.role == 'responsable'
          || currentUser().data.role == 'technicien');
    }

    function canManageReproduction() {
      return signedIn()
        && currentUser().data.actif == true
        && (currentUser().data.role == 'responsable'
          || currentUser().data.role == 'technicien');
    }

    function belongsToMouton(moutonId) {
      return signedIn()
        && currentUser().data.actif == true
        && exists(/databases/$(database)/documents/moutons/$(moutonId))
        && get(/databases/$(database)/documents/moutons/$(moutonId)).data.bergerieId == currentUser().data.bergerieId;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /bergerie_config/{bergerieId} {
      allow read: if isAdmin() || belongsToBergerie(bergerieId);
      allow create, update, delete: if isAdmin();
    }

    match /bergeries/{bergerieId} {
      allow read: if isAdmin() || belongsToBergerie(bergerieId);
      allow create, update, delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if isAdmin() || belongsToClient(clientId);
      allow create, update, delete: if isAdmin();
    }

    // Moutons : isolation stricte par bergerie.
    match /moutons/{moutonId} {
      allow read: if isAdmin()
        || belongsToBergerie(resource.data.bergerieId);

      allow create: if isAdmin()
        || (canCreateMouton()
          && belongsToBergerie(request.resource.data.bergerieId));

      allow update: if isAdmin()
        || (canUpdateMouton()
          && belongsToBergerie(resource.data.bergerieId)
          && request.resource.data.bergerieId == resource.data.bergerieId);

      allow delete: if isAdmin()
        || (canUpdateMouton()
          && belongsToBergerie(resource.data.bergerieId));
    }

    // Reproductions : l'app ne stocke pas directement bergerieId.
    // L'appartenance est donc vérifiée via le mouton concerné.
    match /reproductions/{reproductionId} {
      allow read: if isAdmin()
        || belongsToMouton(resource.data.moutonId);

      allow create: if isAdmin()
        || (canManageReproduction()
          && belongsToMouton(request.resource.data.moutonId));

      allow update: if isAdmin()
        || (canManageReproduction()
          && belongsToMouton(resource.data.moutonId)
          && request.resource.data.moutonId == resource.data.moutonId);

      allow delete: if isAdmin()
        || (canManageReproduction()
          && belongsToMouton(resource.data.moutonId));
    }

    // Mises bas : l'appartenance est vérifiée via le mouton concerné.
    match /mises_bas/{miseBasId} {
      allow read: if isAdmin()
        || belongsToMouton(resource.data.moutonId);

      allow create: if isAdmin()
        || (canManageReproduction()
          && belongsToMouton(request.resource.data.moutonId));

      allow update: if isAdmin()
        || (canManageReproduction()
          && belongsToMouton(resource.data.moutonId)
          && request.resource.data.moutonId == resource.data.moutonId);

      allow delete: if isAdmin()
        || (canManageReproduction()
          && belongsToMouton(resource.data.moutonId));
    }

    // Phase de migration : les autres collections restent accessibles
    // uniquement à l'admin jusqu'à leur migration par bergerie.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
