rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && currentUser().data.actif == true;
    }

    function belongsToBergerie(bergerieId) {
      return activeUser() && currentUser().data.bergerieId == bergerieId;
    }

    function canManageMoutonPhoto(bergerieId) {
      return belongsToBergerie(bergerieId)
        && (currentUser().data.role == 'responsable'
          || currentUser().data.role == 'technicien'
          || currentUser().data.role == 'client');
    }

    match /moutons/{bergerieId}/{moutonId}/{fileName} {
      allow read: if belongsToBergerie(bergerieId)
        || (signedIn() && currentUser().data.role == 'admin' && currentUser().data.actif == true);

      allow write: if canManageMoutonPhoto(bergerieId)
        || (signedIn() && currentUser().data.role == 'admin' && currentUser().data.actif == true);
    }
  }
}
